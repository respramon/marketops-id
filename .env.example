# ---------------------------------------------------------------------------
# MarketOps ID - environment template.  Copy to .env and fill in real values.
# NEVER commit the filled-in .env file.  In CI these come from GitHub Secrets.
# ---------------------------------------------------------------------------

# REQUIRED for live mode. Sectors Financial API key (Insider plan).
# Sent verbatim in the `Authorization` header - no "Bearer " prefix.
# Get it at https://sectors.app -> API -> API Keys
SECTORS_API_KEY=

# OPTIONAL. Discord incoming-webhook URL for the research queue notification.
# If unset, the pipeline still runs and the report is written to disk.
DISCORD_WEBHOOK_URL=

# OPTIONAL. Any other webhook that accepts a JSON POST (Slack-compatible, n8n, etc).
GENERIC_WEBHOOK_URL=

# --- Tuning (all optional; defaults shown) ---------------------------------
MARKETOPS_MAX_API_CREDITS_PER_RUN=15
MARKETOPS_MAX_ENRICH_TICKERS=5
MARKETOPS_LOOKBACK_DAYS=3
MARKETOPS_DB_PATH=data/marketops.db
MARKETOPS_ARTIFACT_DIR=artifacts
MARKETOPS_HTTP_TIMEOUT=15.0
MARKETOPS_MAX_RETRIES=3
MARKETOPS_MAX_CONCURRENCY=3
MARKETOPS_LOG_LEVEL=INFO

# Dashboard host-header allowlist. Add the exact public hostname if deployed.
MARKETOPS_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
# Keep interactive API docs off on public deployments.
MARKETOPS_ENABLE_API_DOCS=false
